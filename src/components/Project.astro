---
import { ProjectCarousel } from './ProjectCarousel';


const projectData = [
  {
    name: "Gaoxy",
    designation: "UI/UX & Frontend",
    quote: "Aplikasi monitoring perkebunan berbasis IoT yang terhubung dengan drone untuk memantau kondisi tanaman secara real-time. Aplikasi ini dapat mendeteksi kadar air tanah, memantau kondisi lingkungan, serta mengendalikan penyiraman dan pemupukan secara lebih efisien.",
    src: "/gaoxy2.webp"
  },
  {
    name: "Heyra",
    designation: "UI/UX & Frontend",
    quote: "Aplikasi penerjemah bahasa isyarat secara real-time yang memanfaatkan teknologi Machine Learning untuk mengenali dan menerjemahkan gerakan tangan menjadi teks atau bahasa yang mudah dipahami.",
    src: "/heyra2.webp"
  },
  {
    name: "Web Document Management System",
    designation: "Web Developer",
    quote: "Web (Laravel) yang digunakan oleh tim internal untuk mengelola pembuatan, pengajuan dan management nota dinas secara digital.",
    src: "/nodin2.webp"
  }
];
---

<section id="project" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-16 py-12 sm:py-20 flex flex-col items-center">
    
    <!-- Judul -->
    <div class="relative inline-block mb-12 sm:mb-16 w-full text-center lg:text-left">
        <div class="relative inline-block">
            <div class="absolute bottom-1 left-0 w-full h-[30%] bg-[#D0A98F] -z-10"></div>
            <h2 class="text-3xl sm:text-4xl font-black text-[#382B25] tracking-wide" style="font-family: 'Montserrat Alternates', sans-serif;">
                Project
            </h2>
        </div>
    </div>

    <!-- Carousel-->
    <div class="w-full bg-[#E6D8CE] rounded-2xl sm:rounded-[2.5rem] p-6 sm:p-8 md:p-12 shadow-sm">
        
        <ProjectCarousel client:visible testimonials={projectData} />
        
    </div>

</section>